{
  "name": "evalh",
  "version": "0.2.0",
  "description": "Configurable agent evaluation harness, built on pi",
  "type": "module",
  "bin": {
    "evalh": "dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "pi-extension",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "docs",
    "templates"
  ],
  "keywords": [
    "pi-package",
    "eval",
    "evalh"
  ],
  "pi": {
    "extensions": [
      "./pi-extension/index.ts"
    ]
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest --run",
    "clean": "node -e \"import('node:fs').then(fs => fs.rmSync('dist', { recursive: true, force: true }))\""
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "1.6.0",
    "@earendil-works/pi-ai": "1.6.0",
    "@earendil-works/pi-agent-core": "1.6.0",
    "yaml": "2.9.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "vitest": "4.1.12",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=22.19"
  },
  "license": "MIT"
}
